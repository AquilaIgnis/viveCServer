# Copy this file to .env before starting the stack:
#   cp env.example .env
# Keep the password URL-safe (letters, numbers, -, _, ., or ~), because Compose
# puts it in the PostgreSQL connection URL.
VIVE_POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_USER=vive
POSTGRES_DB=vive

VIVE_DATABASE_URL=postgres://${POSTGRES_USER}:${VIVE_POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable


# Optional: pin a release instead of following latest.
VIVE_LOG_LEVEL=info
