# Copy this file to .env before starting the stack:
#   cp env.example .env
# Keep the password URL-safe (letters, numbers, -, _, ., or ~), because Compose
# puts it in the PostgreSQL connection URL.
VIVE_POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_USER=vive
POSTGRES_DB=vive

VIVE_DATABASE_URL=postgres://${POSTGRES_USER}:${VIVE_POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable


# Optional: pin a release instead of following latest.
VIVE_LOG_LEVEL=info

# Attachments — the pictures in your notes.
#
# VIVE_MAX_BLOB_BYTES is the largest single picture the server will accept, in bytes. 33554432 is
# 32 MiB, the same limit the app's own notebook export uses, so anything that can be exported can
# also sync. It is the only storage limit there is; the server sets no total per account, because
# your disk is the limit.
VIVE_MAX_BLOB_BYTES=33554432

# How often the server deletes pictures no note refers to any more, and how long it waits before
# doing so. The wait is not housekeeping: it is the time a device that uploaded a picture and then
# lost its connection has to finish sending the note that uses it. Setting the interval to 0 turns
# collection off — the server then uses more disk than it needs to, but never deletes anything.
VIVE_BLOB_SWEEP_INTERVAL=1h
VIVE_BLOB_RETENTION=24h
