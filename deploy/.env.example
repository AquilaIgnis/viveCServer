# Optional overrides for deploy/docker-compose.yml.
# Use only URL-safe characters in the PostgreSQL password (letters, numbers, -, _, ., or ~).
VIVE_POSTGRES_PASSWORD=replace-with-a-long-random-value

# Host ports. Container ports stay 8080 for administration and 8281 for sync.
VIVE_ADMIN_PORT=8080
VIVE_SYNC_PORT=5444

# Pin a release instead of following latest, for example acidburnmonkey/vive-cserver:1.0.0.
VIVE_SERVER_IMAGE=acidburnmonkey/vive-cserver:latest
VIVE_LOG_LEVEL=info
