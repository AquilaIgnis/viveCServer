# Optional overrides for the local deploy/docker-compose.yml stack.
# Use only URL-safe characters in the PostgreSQL password (letters, numbers, -, _, ., or ~).
VIVE_POSTGRES_PASSWORD=replace-with-a-long-random-value

# Host ports. Container ports stay 8080 for administration and 8281 for sync.
VIVE_ADMIN_PORT=8080
VIVE_SYNC_PORT=5444

# docker-compose.dev.yml only: where the published PostgreSQL port listens. The production stack
# keeps PostgreSQL unpublished; 0.0.0.0 exposes it to the LAN, so change it only if you mean to.
VIVE_POSTGRES_BIND=127.0.0.1
VIVE_POSTGRES_PORT=5432

VIVE_LOG_LEVEL=info

# Attachments (S5). The server stores picture bytes in a named Docker volume; these bound what it
# will accept and how long bytes nothing references survive before they are collected.
#
# VIVE_MAX_BLOB_BYTES is per attachment and mirrors the 32 MiB the app's own `.vive` bundles allow.
# It is the only storage limit: there is no per-account quota, because the operator and the user are
# the same person here and the disk is the real limit.
VIVE_MAX_BLOB_BYTES=33554432

# How often unreferenced attachments are collected, and how long they survive after nothing points
# at them. The retention is not tidiness: it is the window in which a client that uploaded a picture
# and then lost connectivity can still push the change that references it. 0 disables sweeping
# entirely, which leaks disk but never loses a byte.
VIVE_BLOB_SWEEP_INTERVAL=1h
VIVE_BLOB_RETENTION=24h
