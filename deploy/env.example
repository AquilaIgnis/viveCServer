# Optional overrides for the local deploy/docker-compose.yml stack.
# Use only URL-safe characters in the PostgreSQL password (letters, numbers, -, _, ., or ~).
VIVE_POSTGRES_PASSWORD=replace-with-a-long-random-value

# Host ports. Container ports stay 8080 for administration and 8281 for sync.
VIVE_ADMIN_PORT=8080
VIVE_SYNC_PORT=5444

# docker-compose.dev.yml only: where the published PostgreSQL port listens. The production stack
# keeps PostgreSQL unpublished; 0.0.0.0 exposes it to the LAN, so change it only if you mean to.
VIVE_POSTGRES_BIND=127.0.0.1
VIVE_POSTGRES_PORT=5432

VIVE_LOG_LEVEL=info
